{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh project item-list *)",
      "Bash(gh api repos/4OH4/yesKnowMaybe/*)",
      "Bash(gh api \"repos/4OH4/yesKnowMaybe/*)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv lock)",
      "Bash(uv add *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run dikms *)",
      "Bash(uv run python scripts/board.py *)",
      "Bash(uv run python scripts/lead.py *)",
      "Bash(date *)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh pr review --approve*)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push --force *)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(uv run dikms extract*)",
      "Bash(uv run dikms fetch*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", ".claude/hooks/notify.ps1"],
            "async": true,
            "timeout": 20,
            "statusMessage": "Notifying"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", ".claude/hooks/notify.ps1"],
            "async": true,
            "timeout": 20,
            "statusMessage": "Notifying"
          }
        ]
      }
    ]
  }
}
