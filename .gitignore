# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Local environment / secrets — never commit credentials
.env
terraform/terraform.tfvars
*.key
*.json.key
application_default_credentials.json
.claude/settings.local.json

# Agent worktrees (see CLAUDE.md, "Agent automation")
.claude/worktrees/

# Fetched source corpus and pipeline output — large, reproducible, not source-controlled.
# The manifest (data/sources.yaml) IS tracked; the downloaded documents are not.
data/corpus/
output/

# Embedded Kùzu knowledge store (storage adapter's local backend). Kùzu 0.11
# keeps the database in one file, with .wal/.shadow siblings while it is open.
data/graph.kuzu/
*.kuzu
*.kuzu.wal
*.kuzu.shadow

# Terraform local state
terraform/.terraform/
*.tfstate
*.tfstate.*
terraform/.terraform.lock.hcl

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
